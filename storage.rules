rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Фото сессий (модерация)
    match /session-photos/{userId}/{sessionId}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Аватары пользователей
    match /avatars/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Фото заведений
    match /places-photos/{placeId}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.admin == true
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ─── ФОТО КУПОНОВ ───
    // Читают все авторизованные (клиенты видят фото в магазине).
    // Загружать может только админ.
    match /coupon-photos/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.admin == true
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}