rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Фото сессий (модерация)
    match /session-photos/{userId}/{sessionId}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Аватары пользователей
    match /avatars/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Фото заведений — админ ИЛИ заведение
    match /places-photos/{placeId}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && (
                        request.auth.token.admin == true
                        || request.auth.token.venue == true
                      )
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Фото купонов — админ ИЛИ заведение
    match /coupon-photos/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && (
                        request.auth.token.admin == true
                        || request.auth.token.venue == true
                      )
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}